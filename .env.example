# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=clinic_management
DB_USERNAME=root
DB_PASSWORD=123456


# Backend Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Frontend URL (dùng để tạo liên kết xác thực email)
FRONTEND_URL=http://localhost:5173

# Email (SMTP) - để trống MAIL_HOST thì link xác thực được in ra log backend (chế độ dev)
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_PASSWORD = App Password 16 ký tự (không phải mật khẩu Gmail)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=MediCare Clinic <no-reply@medicare-clinic.local>
EMAIL_VERIFICATION_EXPIRATION_HOURS=24

# Đăng nhập Google - OAuth 2.0 Client ID (loại "Web application") từ Google Cloud Console
# Authorized JavaScript origins: http://localhost:5173 ; để trống = ẩn nút Google
GOOGLE_CLIENT_ID=

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1
