# Environment variables and secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template

# Local Spring Boot configuration
**/application-local.yml
**/application-local.yaml
**/application-local.properties
**/application-secret*.yml

# Frontend - React / Vite / Node.js
**/node_modules/
**/dist/
**/.vite/
**/coverage/
**/*.tsbuildinfo
**/.cache/

# Node package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Backend - Java / Maven
**/target/
**/build/
**/out/
**/*.class
.mvn/timing.properties

# IDE
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.settings/
.classpath
.project

# Operating systems
.DS_Store
Thumbs.db
Desktop.ini

# Logs and temporary files
*.log
logs/
**/logs/
*.tmp
*.temp
*.bak
*.swp
*.swo

# Local database and backups
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
mysql_data/
mysql-data/
db_data/

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.jks

# Python utilities (if any)
__pycache__/
*.pyc
.venv/
venv/

